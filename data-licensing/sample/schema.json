{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azalealabs.com/schemas/literary-parallel/0.1.0.json",
  "title": "Azalea Literary Parallel Document",
  "description": "One record per translated work. Document-level records preserve the discourse context that makes literary translation data distinct from sentence-level parallel corpora.",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "source_language",
    "target_language",
    "translator",
    "provenance",
    "process",
    "contamination",
    "segments"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "document_id": { "type": "string", "pattern": "^azl-[a-z]{2}-[0-9]{4}$" },
    "source_language": { "type": "string", "description": "BCP 47 / ISO 639-1" },
    "target_language": { "type": "string" },
    "direction": { "type": "string", "examples": ["de-en", "zh-en"] },
    "source_title": { "type": "string" },
    "target_title": { "type": "string" },
    "source_author": { "type": "string" },
    "genre": { "type": "string", "examples": ["literary_fiction", "essay", "poetry"] },
    "form": { "type": "string", "examples": ["short_story", "novel_excerpt", "essay"] },
    "register": {
      "type": "string",
      "enum": ["literary", "journalistic", "technical", "colloquial", "formal"]
    },
    "domain": { "type": "string" },
    "difficulty_tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Open vocabulary. Lets a buyer slice for the phenomena they are training or evaluating on: idiom, wordplay, honorifics, zero_anaphora, culture_bound_terms, register_shift, dialect."
    },
    "editorial_note": { "type": "string" },

    "translator": {
      "type": "object",
      "description": "Identity and credential of the human who produced the target text. The premium in this data is the named, verifiable expert behind each record.",
      "required": ["translator_id", "name", "working_languages"],
      "properties": {
        "translator_id": { "type": "string" },
        "name": { "type": "string" },
        "affiliation": { "type": "string" },
        "credential": { "type": "string" },
        "credential_url": { "type": "string", "format": "uri" },
        "native_language": { "type": "string" },
        "working_languages": { "type": "array", "items": { "type": "string" } }
      }
    },

    "provenance": {
      "type": "object",
      "description": "Two separate rights chains: the source text and the translation. A buyer needs both cleared.",
      "required": ["source_text_license", "translation_license"],
      "properties": {
        "source_publication": {
          "type": "object",
          "properties": {
            "venue": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "folio": { "type": "integer" },
            "source_first_published": { "type": "integer" }
          }
        },
        "source_rights_holder": { "type": "string" },
        "source_text_license": {
          "type": "string",
          "description": "License under which the source text may be redistributed for training, or an explicit NOT CLEARED marker."
        },
        "translation_rights_holder": { "type": "string" },
        "translation_license": { "type": "string" },
        "commissioned_by": { "type": "string" },
        "work_for_hire": { "type": "boolean" }
      }
    },

    "process": {
      "type": "object",
      "description": "How the target text was produced. Buyers discount or reject data that may contain machine output, because training on it recycles model artifacts.",
      "required": ["human_authored", "machine_translation_used"],
      "properties": {
        "human_authored": { "type": "boolean" },
        "machine_translation_used": { "type": "boolean" },
        "mt_post_editing": { "type": "boolean" },
        "llm_assistance": { "type": "string", "enum": ["none", "reference_only", "drafting"] },
        "attestation": { "type": "string" },
        "editorial_passes": { "type": "integer" },
        "delivered": { "type": "string", "format": "date" }
      }
    },

    "contamination": {
      "type": "object",
      "description": "Whether either side of the pair is already on the public web. Uncrawled target text is the part a lab cannot get elsewhere.",
      "properties": {
        "source_text_public": { "type": "boolean" },
        "source_text_url": { "type": "string", "format": "uri" },
        "target_text_public": { "type": "boolean" },
        "target_text_previously_published": { "type": "boolean" },
        "web_crawlable": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },

    "stats": {
      "type": "object",
      "properties": {
        "segments": { "type": "integer" },
        "source_words": {
          "type": "integer",
          "description": "Whitespace tokens. For zh/ja this field counts CJK characters instead; see DATASHEET.md."
        },
        "target_words": { "type": "integer" },
        "annotated_segments": { "type": "integer" }
      }
    },

    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "index", "source_text", "target_text"],
        "properties": {
          "segment_id": { "type": "string" },
          "index": { "type": "integer", "description": "Position in the document. Preserves reading order for document-level training." },
          "source_text": { "type": "string" },
          "target_text": { "type": "string" },
          "alignment": {
            "type": "string",
            "enum": ["1:1", "1:n", "n:1", "n:n"],
            "description": "Human-verified alignment cardinality."
          },
          "alignment_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source_words": { "type": "integer" },
          "target_words": { "type": "integer" },

          "translator_annotation": {
            "type": "object",
            "description": "The rationale layer. Present only on segments the translator flagged as a real decision point. This is the field that has no equivalent in OPUS, CCMatrix, or any scraped corpus, and it is what supports reasoning-trace and preference training rather than plain seq2seq.",
            "properties": {
              "difficulty": { "type": "string" },
              "decision": { "type": "string", "description": "What the translator did." },
              "rationale": { "type": "string", "description": "Why, in the translator's own words." },
              "alternatives_rejected": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Renderings the translator considered and declined. Usable directly as dispreferred completions in a preference pair."
              }
            }
          }
        }
      }
    }
  }
}
