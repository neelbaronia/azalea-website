# Copy to .env.local for local development. Never commit real values.

# Set to 1 to pause automated pending-payment account cleanup during access
# backfills. Unset or 0 resumes cleanup; explicit account deletion is unaffected.
PENDING_ACCOUNT_CLEANUP_PAUSED=0

# Google Ads tag for /listen/* (Search ads -> Listen on Spotify).
# Leave either one unset to skip gtag entirely; the page still works.
# Tag ID, e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion label of the "SpotifyClick" conversion action
NEXT_PUBLIC_GOOGLE_ADS_SPOTIFY_CLICK_LABEL=
