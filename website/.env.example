# Copy to .env.local for local development. Never commit real values.

# Google Ads tag for /listen/* (Search ads -> Listen on Spotify).
# Leave either one unset to skip gtag entirely; the page still works.
# Tag ID, e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion label of the "SpotifyClick" conversion action
NEXT_PUBLIC_GOOGLE_ADS_SPOTIFY_CLICK_LABEL=
